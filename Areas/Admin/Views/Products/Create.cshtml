@model Product
@{
    ViewData["Title"] = "Add product";
}
<div class="panel">
    <h4 class="fw-bold mb-4"><i class="bi bi-plus-circle me-2"></i>Add product</h4>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <partial name="_ProductForm" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-save me-1"></i>Save product</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
