@model Product

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="@((SelectList)ViewBag.Categories)" class="form-select"><option value="">Select...</option></select>
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Price" class="form-label">Price (₹)</label>
        <input asp-for="Price" type="number" step="0.01" min="1" class="form-control" />
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DiscountPercent" class="form-label"></label>
        <input asp-for="DiscountPercent" type="number" min="0" max="90" class="form-control" />
        <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" type="number" min="0" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label class="form-label">Product image (JPG, PNG, WEBP - max 2 MB)</label>
        <div class="d-flex align-items-center gap-3">
            <div class="mini-thumb big" id="imagePreviewBox">
                @if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img src="@Model.ImageUrl" id="imagePreview" class="product-photo" alt="preview" /> }
                else { <img id="imagePreview" class="product-photo d-none" alt="preview" /><i class="bi bi-image text-muted fs-2" id="imagePlaceholder"></i> }
            </div>
            <div>
                <input type="file" name="image" id="imageInput" accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control" />
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="removeImage" value="true" id="removeImage" /><label class="form-check-label" for="removeImage">Remove current image</label></div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-check form-switch"><input asp-for="IsFeatured" class="form-check-input" /><label asp-for="IsFeatured" class="form-check-label"></label></div>
    </div>
    <div class="col-md-6">
        <div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
</div>
