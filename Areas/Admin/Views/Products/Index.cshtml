@model List<Product>
@{
    ViewData["Title"] = "Products - Admin";
    string? q = ViewBag.Query;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="fw-bold mb-0">Products <span class="text-muted fs-6">(@ViewBag.Total)</span></h3>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="q" value="@q" class="form-control" placeholder="Search..." />
            <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
        </form>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add</a>
    </div>
</div>

<div class="panel p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="mini-thumb"><partial name="_ProductImage" model="p" /></div>
                                <div>
                                    <div class="fw-semibold">@p.Name</div>
                                    @if (p.IsFeatured) { <span class="badge bg-primary-subtle text-primary-emphasis">Featured</span> }
                                </div>
                            </div>
                        </td>
                        <td>@p.Category?.Name</td>
                        <td>
                            @Fmt.Money(p.FinalPrice)
                            @if (p.DiscountPercent > 0) { <div class="small text-muted"><s>@Fmt.Money(p.Price)</s> (-@p.DiscountPercent%)</div> }
                        </td>
                        <td><span class="badge @(p.Stock == 0 ? "bg-danger" : p.Stock <= 5 ? "bg-warning text-dark" : "bg-success")">@p.Stock</span></td>
                        <td>@(p.IsActive ? "Visible" : "Hidden")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirm="Delete '@p.Name'?">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No products found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-page="@i">@i</a></li>
            }
        </ul>
    </nav>
}
