@model Product
@{
    ViewData["Title"] = "Edit product";
}
<div class="panel">
    <h4 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2"></i>Edit product</h4>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <partial name="_ProductForm" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-save me-1"></i>Update</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
