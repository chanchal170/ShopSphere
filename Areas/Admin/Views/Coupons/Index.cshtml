@model List<Coupon>
@{
    ViewData["Title"] = "Coupons - Admin";
}
<h3 class="fw-bold mb-3">Coupons</h3>

<div class="panel mb-4">
    <h6 class="mb-3">Create coupon</h6>
    <form asp-action="Create" method="post">
        <div class="row g-2">
            <div class="col-md-3"><input name="Code" class="form-control text-uppercase" placeholder="CODE" required maxlength="20" /></div>
            <div class="col-md-9"><input name="Description" class="form-control" placeholder="Description shown to admin" maxlength="120" /></div>
            <div class="col-6 col-md-2"><input name="DiscountPercent" type="number" min="0" max="100" class="form-control" placeholder="% off" value="0" /></div>
            <div class="col-6 col-md-2"><input name="FlatAmount" type="number" min="0" class="form-control" placeholder="Flat ₹" value="0" /></div>
            <div class="col-6 col-md-2"><input name="MaxDiscount" type="number" min="0" class="form-control" placeholder="Max ₹ (for %)" value="0" /></div>
            <div class="col-6 col-md-2"><input name="MinOrderAmount" type="number" min="0" class="form-control" placeholder="Min order ₹" value="0" /></div>
            <div class="col-6 col-md-2"><input name="ExpiresOn" type="date" class="form-control" /></div>
            <div class="col-6 col-md-2"><input name="UsageLimit" type="number" min="0" class="form-control" placeholder="Uses (0 = no limit)" value="0" /></div>
        </div>
        <button class="btn btn-primary mt-3" type="submit"><i class="bi bi-plus-lg me-1"></i>Create coupon</button>
        <span class="small text-muted ms-2">Use either a percentage or a flat amount.</span>
    </form>
</div>

<div class="panel p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Code</th><th>Discount</th><th>Min order</th><th>Used</th><th>Expires</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Code</strong><div class="small text-muted">@c.Description</div></td>
                        <td>@(c.DiscountPercent > 0 ? $"{c.DiscountPercent}%" + (c.MaxDiscount > 0 ? $" (max {Fmt.Money(c.MaxDiscount)})" : "") : Fmt.Money(c.FlatAmount))</td>
                        <td>@Fmt.Money(c.MinOrderAmount)</td>
                        <td>@c.TimesUsed@(c.UsageLimit > 0 ? " / " + c.UsageLimit : "")</td>
                        <td>@(c.ExpiresOn.HasValue ? Fmt.Date(c.ExpiresOn.Value) : "Never")</td>
                        <td><span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Disabled")</span></td>
                        <td class="text-end text-nowrap">
                            <form asp-action="Toggle" asp-route-id="@c.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">@(c.IsActive ? "Disable" : "Enable")</button></form>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="Delete coupon @c.Code?"><button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button></form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
