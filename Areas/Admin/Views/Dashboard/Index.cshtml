@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
}
<h3 class="fw-bold mb-4">Dashboard</h3>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="kpi"><div class="kpi-icon bg-success-subtle text-success"><i class="bi bi-currency-rupee"></i></div><div><div class="kpi-num">@Fmt.Money(Model.TotalRevenue)</div><div class="kpi-label">Total revenue</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="kpi"><div class="kpi-icon bg-primary-subtle text-primary"><i class="bi bi-receipt"></i></div><div><div class="kpi-num" data-count="@Model.TotalOrders">0</div><div class="kpi-label">Total orders</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="kpi"><div class="kpi-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split"></i></div><div><div class="kpi-num" data-count="@Model.PendingOrders">0</div><div class="kpi-label">Pending orders</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="kpi"><div class="kpi-icon bg-info-subtle text-info-emphasis"><i class="bi bi-people"></i></div><div><div class="kpi-num" data-count="@Model.TotalCustomers">0</div><div class="kpi-label">Customers</div></div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="panel d-flex justify-content-between align-items-center"><span class="text-muted">Revenue today</span><strong>@Fmt.Money(Model.RevenueToday)</strong></div></div>
    <div class="col-md-4"><div class="panel d-flex justify-content-between align-items-center"><span class="text-muted">Orders today</span><strong>@Model.OrdersToday</strong></div></div>
    <div class="col-md-4"><div class="panel d-flex justify-content-between align-items-center"><span class="text-muted">Products</span><strong>@Model.TotalProducts</strong></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8"><div class="panel h-100"><h6 class="mb-3">Revenue - last 7 days (₹)</h6><canvas id="revChart" height="130"></canvas></div></div>
    <div class="col-lg-4"><div class="panel h-100"><h6 class="mb-3">Orders by status</h6><canvas id="statusChart" height="220"></canvas></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel p-0">
            <div class="p-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Recent orders</h6>
                <a asp-action="Index" asp-controller="Orders" class="small">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var o in Model.RecentOrders)
                        {
                            <tr>
                                <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">@o.OrderNumber</a></td>
                                <td>@o.ShippingName</td>
                                <td>@Fmt.Money(o.Total)</td>
                                <td><span class="badge @Fmt.StatusClass(o.Status)">@o.Status</span></td>
                            </tr>
                        }
                        @if (!Model.RecentOrders.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">No orders yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel mb-4">
            <h6 class="mb-3">Top selling products</h6>
            @if (!Model.TopProducts.Any()) { <p class="text-muted mb-0">No sales yet.</p> }
            else
            {
                var max = Model.TopProducts.Max(t => t.Quantity);
                foreach (var t in Model.TopProducts)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small"><span class="text-truncate me-2">@t.Name</span><span class="text-muted">@t.Quantity sold</span></div>
                        <div class="progress" style="height:8px"><div class="progress-bar" style="width:@(t.Quantity * 100 / max)%"></div></div>
                    </div>
                }
            }
        </div>
        <div class="panel">
            <h6 class="mb-3"><i class="bi bi-exclamation-triangle text-warning me-1"></i>Low stock</h6>
            @if (!Model.LowStock.Any()) { <p class="text-muted mb-0">All products are well stocked.</p> }
            else
            {
                foreach (var p in Model.LowStock)
                {
                    <div class="d-flex justify-content-between align-items-center py-1">
                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id" class="text-truncate me-2">@p.Name</a>
                        <span class="badge @(p.Stock == 0 ? "bg-danger" : "bg-warning text-dark")">@(p.Stock == 0 ? "Out" : p.Stock + " left")</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        initAdminCharts({
            dayLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DayLabels)),
            dayRevenue: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DayRevenue)),
            statusLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusLabels)),
            statusCounts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusCounts))
        });
    </script>
}
