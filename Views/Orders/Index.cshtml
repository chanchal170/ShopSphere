@model List<Order>
@{
    ViewData["Title"] = "My orders";
}
<div class="page-header">
    <div class="container"><h1 class="fw-bold mb-0"><i class="bi bi-box-seam me-2"></i>My orders</h1></div>
</div>
<div class="container py-4">
    @if (!Model.Any())
    {
        <div class="empty-state text-center">
            <i class="bi bi-bag-x display-1 text-muted"></i>
            <h4 class="mt-3">No orders yet</h4>
            <a class="btn btn-primary mt-2" asp-area="" asp-controller="Shop" asp-action="Index">Start shopping</a>
        </div>
    }
    else
    {
        foreach (var o in Model)
        {
            <div class="panel mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div>
                        <div class="fw-bold">@o.OrderNumber</div>
                        <div class="small text-muted">Placed on @Fmt.Stamp(o.CreatedAt)</div>
                    </div>
                    <span class="badge @Fmt.StatusClass(o.Status) fs-6">@o.Status</span>
                </div>
                <div class="small text-muted mb-3">
                    @string.Join(", ", o.Items.Take(3).Select(i => $"{i.ProductName} x{i.Quantity}"))@(o.Items.Count > 3 ? $" and {o.Items.Count - 3} more" : "")
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="fs-5 fw-bold">@Fmt.Money(o.Total)</div>
                    <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">View details</a>
                </div>
            </div>
        }
    }
</div>
