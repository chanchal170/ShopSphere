@{
    int code = ViewBag.Code ?? 404;
    ViewData["Title"] = code == 404 ? "Page not found" : "Error " + code;
}
<div class="container py-5 text-center">
    <div class="display-1 fw-bold text-gradient">@code</div>
    @if (code == 404)
    {
        <h2 class="mt-2">We could not find that page</h2>
        <p class="text-muted">The page may have been moved or the link is wrong.</p>
    }
    else if (code == 403)
    {
        <h2 class="mt-2">Access denied</h2>
        <p class="text-muted">You do not have permission to open this page.</p>
    }
    else
    {
        <h2 class="mt-2">Something went wrong</h2>
        <p class="text-muted">Please try again in a moment.</p>
    }
    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Go home</a>
        <a class="btn btn-outline-primary" asp-area="" asp-controller="Shop" asp-action="Index">Browse products</a>
    </div>
</div>
