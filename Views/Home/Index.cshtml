@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge hero-badge mb-3"><i class="bi bi-lightning-charge-fill me-1"></i>New season deals are live</span>
                <h1 class="display-4 fw-bold mb-3">Shop smart. <span class="text-gradient">Live better.</span></h1>
                <p class="lead text-muted mb-4">
                    Thousands of happy customers trust ShopSphere for electronics, fashion, home essentials, books and more -
                    with fast delivery and easy returns.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Shop" asp-action="Index"><i class="bi bi-bag me-2"></i>Shop now</a>
                    <a class="btn btn-outline-primary btn-lg" asp-area="" asp-controller="Shop" asp-action="Index" asp-route-sort="discount">View deals</a>
                </div>
                <div class="d-flex gap-4 small text-muted">
                    <span><i class="bi bi-shield-check text-success me-1"></i>Secure checkout</span>
                    <span><i class="bi bi-truck text-primary me-1"></i>Fast delivery</span>
                    <span><i class="bi bi-arrow-repeat text-warning me-1"></i>Easy cancel</span>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-visual">
                    <div class="hero-blob"></div>
                    <div class="floating-card fc-1"><i class="bi bi-check-circle-fill text-success me-2"></i>Order delivered</div>
                    <div class="floating-card fc-2"><i class="bi bi-star-fill text-warning me-2"></i>4.8 customer rating</div>
                    <div class="floating-card fc-3"><i class="bi bi-percent text-primary me-2"></i>Up to 40% off</div>
                    <div class="hero-icons">
                        <div class="hi hi-1"><i class="bi bi-laptop"></i></div>
                        <div class="hi hi-2"><i class="bi bi-bag"></i></div>
                        <div class="hi hi-3"><i class="bi bi-house-door"></i></div>
                        <div class="hi hi-4"><i class="bi bi-book"></i></div>
                        <div class="hi hi-5"><i class="bi bi-bicycle"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STATS -->
<section class="container stats-strip">
    <div class="row g-3 text-center">
        <div class="col-6 col-md-3"><div class="stat-box"><div class="stat-num" data-count="@Model.ProductCount">0</div><div class="stat-label">Products</div></div></div>
        <div class="col-6 col-md-3"><div class="stat-box"><div class="stat-num" data-count="@Model.Categories.Count">0</div><div class="stat-label">Categories</div></div></div>
        <div class="col-6 col-md-3"><div class="stat-box"><div class="stat-num" data-count="@Model.CustomerCount">0</div><div class="stat-label">Customers</div></div></div>
        <div class="col-6 col-md-3"><div class="stat-box"><div class="stat-num" data-count="@Model.OrderCount">0</div><div class="stat-label">Orders delivered</div></div></div>
    </div>
</section>

<!-- CATEGORIES -->
<section class="container py-5">
    <div class="section-head">
        <h2 class="fw-bold">Shop by category</h2>
        <p class="text-muted">Find exactly what you are looking for</p>
    </div>
    <div class="row g-3">
        @foreach (var c in Model.Categories)
        {
            var hue = Fmt.Hue(c.Name);
            <div class="col-6 col-md-4 col-lg">
                <a class="cat-tile" style="--h:@hue" asp-area="" asp-controller="Shop" asp-action="Index" asp-route-category="@c.Id">
                    <i class="bi bi-@c.Icon"></i>
                    <div class="fw-semibold">@c.Name</div>
                    <small>@(Model.CategoryCounts.TryGetValue(c.Id, out var n) ? n : 0) items</small>
                </a>
            </div>
        }
    </div>
</section>

<!-- FEATURED -->
<section class="container pb-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">Featured products</h2>
            <p class="text-muted mb-0">Handpicked and highly rated</p>
        </div>
        <a class="btn btn-outline-primary" asp-area="" asp-controller="Shop" asp-action="Index">View all <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    <div class="row g-4">
        @foreach (var p in Model.Featured)
        {
            <div class="col-6 col-md-4 col-lg-3">
                @await Html.PartialAsync("_ProductCard", p, new ViewDataDictionary(ViewData) { { "InWishlist", Model.WishlistIds.Contains(p.Id) } })
            </div>
        }
    </div>
</section>

<!-- DEALS BANNER -->
<section class="container py-4">
    <div class="deal-banner">
        <div>
            <span class="badge bg-light text-dark mb-2">Limited time</span>
            <h2 class="fw-bold">Save more with coupon <span class="code">WELCOME10</span></h2>
            <p class="mb-0 opacity-75">Get 10% off (up to ₹300) on orders above ₹500. Free shipping on orders above ₹500.</p>
        </div>
        <a class="btn btn-light btn-lg" asp-area="" asp-controller="Shop" asp-action="Index">Start shopping</a>
    </div>
</section>

<!-- DEALS -->
<section class="container py-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">Hot deals</h2>
            <p class="text-muted mb-0">Biggest discounts right now</p>
        </div>
        <a class="btn btn-outline-primary" asp-area="" asp-controller="Shop" asp-action="Index" asp-route-sort="discount">All deals <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    <div class="row g-4">
        @foreach (var p in Model.Deals)
        {
            <div class="col-6 col-md-4 col-lg-3">
                @await Html.PartialAsync("_ProductCard", p, new ViewDataDictionary(ViewData) { { "InWishlist", Model.WishlistIds.Contains(p.Id) } })
            </div>
        }
    </div>
</section>

<!-- NEW ARRIVALS -->
<section class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">New arrivals</h2>
        <p class="text-muted mb-0">Fresh on our shelves</p>
    </div>
    <div class="row g-4">
        @foreach (var p in Model.NewArrivals)
        {
            <div class="col-6 col-md-4 col-lg-3">
                @await Html.PartialAsync("_ProductCard", p, new ViewDataDictionary(ViewData) { { "InWishlist", Model.WishlistIds.Contains(p.Id) } })
            </div>
        }
    </div>
</section>

<!-- WHY US -->
<section class="container py-5">
    <div class="row g-4">
        <div class="col-md-4"><div class="feature-card"><div class="icon-box"><i class="bi bi-truck"></i></div><h5>Fast delivery</h5><p>Free shipping on orders above ₹500, delivered to your door.</p></div></div>
        <div class="col-md-4"><div class="feature-card"><div class="icon-box"><i class="bi bi-shield-lock"></i></div><h5>Secure accounts</h5><p>Protected with ASP.NET Core Identity - hashed passwords and account lockout.</p></div></div>
        <div class="col-md-4"><div class="feature-card"><div class="icon-box"><i class="bi bi-arrow-repeat"></i></div><h5>Easy cancellation</h5><p>Cancel pending orders anytime and the stock is returned automatically.</p></div></div>
    </div>
</section>
