@model object
@{
    ViewData["Title"] = "Error";
}
<div class="container py-5 text-center">
    <i class="bi bi-exclamation-triangle display-1 text-danger"></i>
    <h1 class="mt-3">Something went wrong</h1>
    <p class="text-muted">Sorry, an unexpected error occurred. Request ID: <code>@Model</code></p>
    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
