@model List<WishlistItem>
@{
    ViewData["Title"] = "Wishlist";
}
<div class="page-header">
    <div class="container"><h1 class="fw-bold mb-0"><i class="bi bi-heart me-2"></i>My wishlist</h1></div>
</div>
<div class="container py-4" id="wishlistPage">
    @if (!Model.Any())
    {
        <div class="empty-state text-center">
            <i class="bi bi-heart display-1 text-muted"></i>
            <h4 class="mt-3">Your wishlist is empty</h4>
            <p class="text-muted">Tap the heart on any product to save it here.</p>
            <a class="btn btn-primary" asp-area="" asp-controller="Shop" asp-action="Index">Browse products</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var w in Model)
            {
                <div class="col-6 col-md-4 col-lg-3 wish-col">
                    @await Html.PartialAsync("_ProductCard", w.Product!, new ViewDataDictionary(ViewData) { { "InWishlist", true } })
                </div>
            }
        </div>
    }
</div>
