<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopSphere</title>

    <!-- apply the saved theme before the page paints (prevents a flash) -->
    <script>
        (function () {
            document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('theme') || 'light');
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="topbar d-none d-md-block">
        <div class="container d-flex justify-content-between">
            <span><i class="bi bi-truck me-1"></i>Free shipping on orders above ₹500</span>
            <span><i class="bi bi-tag me-1"></i>Use code <strong>WELCOME10</strong> for 10% off</span>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg app-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bag-heart-fill me-1"></i>Shop<span class="text-gradient">Sphere</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-3 mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Shop" asp-action="Index">Shop</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Categories</a>
                        @await Component.InvokeAsync("NavCategories")
                    </li>
                </ul>

                <form class="nav-search flex-grow-1 me-lg-3 mb-2 mb-lg-0" asp-area="" asp-controller="Shop" asp-action="Index" method="get">
                    <i class="bi bi-search"></i>
                    <input type="search" id="navSearch" name="q" class="form-control" placeholder="Search products..." autocomplete="off" />
                    <div id="navSuggest" class="suggest-box d-none"></div>
                </form>

                <div class="d-flex align-items-center gap-2">
                    <button id="themeToggle" class="btn btn-sm btn-icon" type="button" title="Toggle dark mode">
                        <i class="bi bi-moon-stars-fill"></i>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-sm btn-icon" asp-area="" asp-controller="Wishlist" asp-action="Index" title="Wishlist"><i class="bi bi-heart"></i></a>
                    }

                    <a class="btn btn-sm btn-icon position-relative" asp-area="" asp-controller="Cart" asp-action="Index" title="Cart">
                        <i class="bi bi-cart3"></i>
                        @await Component.InvokeAsync("CartBadge")
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var fullName = User.FindFirst("FullName")?.Value ?? User.Identity!.Name ?? "User";
                        <div class="dropdown">
                            <a class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                <span class="avatar">@fullName.Substring(0, 1).ToUpper()</span>
                                <span class="d-none d-xl-inline">@fullName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text small text-muted">Signed in as<br /><strong>@User.Identity!.Name</strong></span></li>
                                <li><hr class="dropdown-divider" /></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin panel</a></li>
                                }
                                <li><a class="dropdown-item" asp-area="" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2"></i>My orders</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>Wishlist</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Sign up</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="app-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold"><i class="bi bi-bag-heart-fill me-1"></i>Shop<span class="text-gradient">Sphere</span></h5>
                    <p class="text-muted small">A complete e-commerce demo built with ASP.NET Core MVC, Entity Framework Core and Identity.</p>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Shop</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-area="" asp-controller="Shop" asp-action="Index">All products</a></li>
                        <li><a asp-area="" asp-controller="Shop" asp-action="Index" asp-route-sort="discount">Best deals</a></li>
                        <li><a asp-area="" asp-controller="Shop" asp-action="Index" asp-route-sort="rating">Top rated</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Account</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-area="" asp-controller="Orders" asp-action="Index">My orders</a></li>
                        <li><a asp-area="" asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                        <li><a asp-area="" asp-controller="Cart" asp-action="Index">Cart</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Developers</h6>
                    <ul class="list-unstyled small">
                        <li><a href="/swagger" target="_blank">REST API docs (Swagger)</a></li>
                        <li><a href="/health" target="_blank">Health check</a></li>
                    </ul>
                </div>
            </div>
            <hr />
            <div class="small text-muted d-flex flex-column flex-md-row justify-content-between">
                <span>&copy; @DateTime.Now.Year ShopSphere. Student project.</span>
                <span>ASP.NET Core &bull; EF Core &bull; Identity &bull; Bootstrap 5</span>
            </div>
        </div>
    </footer>

    <!-- anti-forgery token used by AJAX calls -->
    <form id="antiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["Success"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString())), 'success'); });</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString())), 'danger'); });</script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
