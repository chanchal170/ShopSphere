@model double
<span class="stars">
    @for (int i = 1; i <= 5; i++)
    {
        if (Model >= i)
        {
            <i class="bi bi-star-fill"></i>
        }
        else if (Model >= i - 0.5)
        {
            <i class="bi bi-star-half"></i>
        }
        else
        {
            <i class="bi bi-star"></i>
        }
    }
</span>
