@model Order
@{
    ViewData["Title"] = "Order placed";
}
<div class="container py-5" style="max-width: 760px;">
    <div class="panel text-center">
        <div class="success-check"><i class="bi bi-check-lg"></i></div>
        <h2 class="fw-bold mt-3">Thank you for your order!</h2>
        <p class="text-muted">Your order <strong>@Model.OrderNumber</strong> has been placed successfully.</p>

        <div class="text-start my-4">
            @foreach (var i in Model.Items)
            {
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span>@i.ProductName <span class="text-muted">x @i.Quantity</span></span>
                    <span>@Fmt.Money(i.LineTotal)</span>
                </div>
            }
            <div class="d-flex justify-content-between pt-3 fs-5 fw-bold"><span>Total</span><span>@Fmt.Money(Model.Total)</span></div>
        </div>

        <div class="small text-muted mb-4">
            Delivering to <strong>@Model.ShippingName</strong>, @Model.Address, @Model.City &bull; Payment: @Model.PaymentMethod
        </div>

        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a class="btn btn-primary" asp-area="" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id">View order</a>
            <a class="btn btn-outline-primary" asp-area="" asp-controller="Shop" asp-action="Index">Continue shopping</a>
        </div>
    </div>
</div>
