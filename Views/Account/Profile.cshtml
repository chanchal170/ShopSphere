@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var fullName = string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName;
}
<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="panel text-center">
                <div class="avatar avatar-xl mx-auto mb-3">@fullName.Substring(0, 1).ToUpper()</div>
                <h4 class="mb-1">@Model.FullName</h4>
                <p class="text-muted mb-3">@Model.Email</p>
                <div class="row">
                    <div class="col"><div class="fs-3 fw-bold">@Model.OrderCount</div><div class="small text-muted">Orders</div></div>
                    <div class="col"><div class="fs-6 fw-bold mt-2">@Fmt.Date(Model.MemberSince)</div><div class="small text-muted">Member since</div></div>
                </div>
                <hr />
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-1"></i>My orders</a>
                    <a class="btn btn-outline-secondary" asp-area="" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-1"></i>Change password</a>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="panel">
                <h5 class="mb-4">Edit profile</h5>
                <form asp-area="" asp-controller="Account" asp-action="Profile" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input class="form-control" value="@Model.Email" disabled />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">Default delivery address</label>
                            <textarea asp-for="Address" rows="3" class="form-control"></textarea>
                        </div>
                    </div>
                    <button class="btn btn-primary mt-4" type="submit"><i class="bi bi-save me-1"></i>Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>
